{{range $l := .}}
<div class="line"  hx-get="/desktop/actions?path={{.Path}}" hx-trigger="getdetails" hx-swap="outerHTML" hx-on::after-swap="console.log('swapped')" hx-on::after-settle="console.log('settled')">
	<div class="icon">
		{{if .Icon}}
			<img src="{{.Icon}}" height="32" width="32" class="icon">
		{{end}}
	</div>
	<div>
		<div class="title" {{with .FirstAction}}data-post="{{.Href}}"{{end}} {{with .DeleteAction}}data-delete="{{.Href}}"{{end}} tabindex="0">
			{{.Title}}
		</div>
		<div class="kind">
			{{.Summary}}
		</div>
	</div>
</div>
{{end}}
