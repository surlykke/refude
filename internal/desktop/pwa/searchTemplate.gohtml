{{range $l := .}}
<div class="line">
	<div class="icon">
		{{if .Icon}}
			<img src="{{.Icon}}" height="32" width="32" class="icon">
		{{end}}
	</div>
	<div x-data="{details: false}" @toggledetails="console.log('toggle'); details = !details">
		<div class="title" {{with .FirstAction}}data-post="{{.Href}}"{{end}} {{with .DeleteAction}}data-delete="{{.Href}}"{{end}} tabindex="0">
			{{.Title}}
		</div>
		<div class="kind" x-show="! details">
			{{.Summary}}
		</div>
		{{range .SecondaryActions}} 
		<div class="action" data-post="{{.Href}}" tabindex="0" x-show="details">
			{{.Title}}
		</div>
		{{end}}
	</div>
</div>
{{end}}
